# ============================================================================
# RECOPS Scorecard Extractor -- secrets.toml template
# ----------------------------------------------------------------------------
# On Streamlit Community Cloud: paste the contents of this file (with real
# values filled in) into App settings -> Secrets.
# Locally: copy this file to .streamlit/secrets.toml in the same folder as
# recops_app.py and edit the values.
#
# If you keep the [auth] block, the app forces sign-in. If you delete the
# [auth] block, the login gate is skipped (useful for local development).
# ============================================================================

# ---- API keys used by the scoring engine ----
GITHUB_TOKEN  = "ghp_your_real_github_token_here"
GROQ_API_KEY  = "gsk_your_real_groq_key_here"

# ---- Email allowlist (who is allowed in after sign-in) ----
# List form is cleanest. Wildcards like "*@your-university.edu" let anyone
# from a domain in. Leave empty/missing to allow anyone with a Google account.
allowed_emails = [
    "your.email@gmail.com",
    "professor@university.edu",
    # "*@university.edu",
]

# ============================================================================
# OAuth / OpenID Connect configuration for st.login()
# Pick ONE provider below. Google is easiest. See the deploy guide for the
# 4 steps needed to create the OAuth client.
# ============================================================================

[auth]
# Where Google will redirect after the user signs in. Use the EXACT URL of
# your deployed app, with /oauth2callback appended.
redirect_uri    = "https://your-app-name.streamlit.app/oauth2callback"

# Random string used to sign the session cookie. Generate one with:
#    python -c "import secrets; print(secrets.token_urlsafe(64))"
cookie_secret   = "PASTE_A_LONG_RANDOM_STRING_HERE"

# From Google Cloud Console -> APIs & Services -> Credentials -> your OAuth
# 2.0 Client ID (Web application type).
client_id       = "xxxxxxxxxxxx.apps.googleusercontent.com"
client_secret   = "GOCSPX-xxxxxxxxxxxxxxxxxxxx"

# Google's OIDC discovery URL -- leave as is.
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# (Optional) restrict the OAuth flow to certain scopes / hosted domains
# client_kwargs = { scope = "openid email profile" }
